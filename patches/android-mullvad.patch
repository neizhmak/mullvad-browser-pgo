+p_rustlog = Path("mobile/android/android-components/components/support/appservices/src/main/java/mozilla/components/support/rustlog/RustLog.kt")
+if p_rustlog.is_file():
+    t = p_rustlog.read_text(encoding="utf-8")
+    p_rustlog.write_text(t.replace("Level.ERROR -> Log.Priority.ERROR", "else -> Log.Priority.ERROR"), encoding="utf-8")
+
+# 2. AccountEvent.kt
+p_acct = Path("mobile/android/android-components/components/concept/sync/src/main/java/mozilla/components/concept/sync/AccountEvent.kt")
+if p_acct.is_file():
+    t = p_acct.read_text(encoding="utf-8")
+    p_acct.write_text(t.replace("sealed class DeviceCommandOutgoing {", "sealed class DeviceCommandOutgoing {\n    /** A command to do nothing */\n    class Noop() : DeviceCommandOutgoing()\n", 1), encoding="utf-8")
+
+# 3. RemoteTabsStorage.kt
+p_rts = Path("mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/RemoteTabsStorage.kt")
+if p_rts.is_file():
+    t = p_rts.read_text(encoding="utf-8")
+    t = t.replace("is RemoteCommand.CloseTab -> PendingCommandGroup.Key.CloseTab(it.deviceId)", "is RemoteCommand.CloseTab -> PendingCommandGroup.Key.CloseTab(it.deviceId)\n                    else -> PendingCommandGroup.Key.Noop(it.deviceId)")
+    t = t.replace("sealed interface Key {\n            data class CloseTab(val deviceId: String) : Key", "sealed interface Key {\n            data class CloseTab(val deviceId: String) : Key\n            data class Noop(val deviceId: String) : Key")
+    old_grp = '''                            pendingCommands = pendingCommands,
+                        )
+                    }
+                    // Add `is ... ->` branches for future pending command grouping keys here...'''
+    new_grp = '''                            pendingCommands = pendingCommands,
+                        )
+                    }
+                    is PendingCommandGroup.Key.Noop -> {
+                        PendingCommandGroup(
+                            deviceId = key.deviceId,
+                            command = DeviceCommandOutgoing.Noop(),
+                            pendingCommands = pendingCommands,
+                        )
+                    }
+                    // Add `is ... ->` branches for future pending command grouping keys here...'''
+    p_rts.write_text(t.replace(old_grp, new_grp, 1), encoding="utf-8")
+
+# 4. FxaDeviceConstellation.kt
+p_fxa = Path("mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FxaDeviceConstellation.kt")
+if p_fxa.is_file():
+    t = p_fxa.read_text(encoding="utf-8")
+    old_cmd = '''                is DeviceCommandOutgoing.CloseTab -> {
+                    when (val closeTabsResult = account.closeTabs(targetDeviceId, outgoingCommand.urls)) {
+                        is RustCloseTabsResult.Ok -> Result.success(true)
+                        is RustCloseTabsResult.TabsNotClosed ->
+                            Result.failure(SendCommandException.TabsNotClosed(closeTabsResult.urls))
+                    }
+                }'''
+    new_cmd = '''                is DeviceCommandOutgoing.CloseTab -> {
+                    when (val closeTabsResult = account.closeTabs(targetDeviceId, outgoingCommand.urls)) {
+                        is RustCloseTabsResult.Ok -> Result.success(true)
+                        is RustCloseTabsResult.TabsNotClosed ->
+                            Result.failure(SendCommandException.TabsNotClosed(closeTabsResult.urls))
+                        else -> Result.success(false)
+                    }
+                }
+                else -> Result.success(false)'''
+    if old_cmd in t:
+        p_fxa.write_text(t.replace(old_cmd, new_cmd, 1), encoding="utf-8")
+
+# 5. Types.kt
+p_types = Path("mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/Types.kt")
+if p_types.is_file():
+    t = p_types.read_text(encoding="utf-8")
+    t = t.replace("RustDeviceType.UNKNOWN -> DeviceType.UNKNOWN", "else -> DeviceType.UNKNOWN")
+    t = t.replace("RustDeviceCapability.CLOSE_TABS -> DeviceCapability.CLOSE_TABS", "else -> DeviceCapability.CLOSE_TABS")
+    t = t.replace("is AccountEvent.Unknown -> mozilla.components.concept.sync.AccountEvent.Unknown", "else -> mozilla.components.concept.sync.AccountEvent.Unknown")
+    t = t.replace("is IncomingDeviceCommand.TabsClosed -> this.into()", "is IncomingDeviceCommand.TabsClosed -> this.into()\n        else -> this.into()")
+    p_types.write_text(t, encoding="utf-8")
+
+# 6. WorkManagerSyncManager.kt
+p_wmsm = Path("mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt")
+if p_wmsm.is_file():
+    t = p_wmsm.read_text(encoding="utf-8")
+    p_wmsm.write_text(t.replace("return when (syncResult.status) {", "return when (syncResult.status) {\n            ServiceStatus.__NOOP -> Result.success()", 1), encoding="utf-8")
+
+# 7. Types.kt in sync-logins (BulkResultEntry.__NOOP)
+p_logins = Path("mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/Types.kt")
+if p_logins.is_file():
+    t = p_logins.read_text(encoding="utf-8")
+    old = 'is BulkResultEntry.Error -> Result.failure(BulkInsertionError(this.message))'
+    new = 'is BulkResultEntry.Error -> Result.failure(BulkInsertionError(this.message))\n    else -> Result.failure(BulkInsertionError("No-op bulk insertion"))'
+    p_logins.write_text(t.replace(old, new, 1), encoding="utf-8")
+
+# 8. NimbusGeckoUtils.kt (PrefBranch.__NOOP)
+p_ngu = Path("mobile/android/fenix/app/src/main/java/org/mozilla/fenix/experiments/prefhandling/NimbusGeckoUtils.kt")
+if p_ngu.is_file():
+    t = p_ngu.read_text(encoding="utf-8")
+    old_b = '''fun PrefBranch.toBrowserPrefBranch(): Branch {
+    return when (this) {
+        PrefBranch.DEFAULT -> Branch.DEFAULT
+        PrefBranch.USER -> Branch.USER
+    }
+}'''
+    new_b = '''fun PrefBranch.toBrowserPrefBranch(): Branch {
+    return when (this) {
+        PrefBranch.DEFAULT -> Branch.DEFAULT
+        PrefBranch.USER -> Branch.USER
+        else -> Branch.DEFAULT
+    }
+}'''
+    if old_b in t:
+        p_ngu.write_text(t.replace(old_b, new_b, 1), encoding="utf-8")
+PY_AS_NOOP
+[% END -%]
+
+[% IF c("var/pgo_use") -%]
+  [% IF c("var/pgo_generate") -%]
+    echo 'PGO generation and profile use are mutually exclusive' >&2
+    exit 1
+  [% END -%]
+  mkdir -p /var/tmp/dist/pgo
+  cp "$rootdir/[% c('input_files_by_name/pgo-profdata') %]" /var/tmp/dist/pgo/merged.profdata
+  [% IF c("var/pgo_jarlog_sha256") -%]
+  cp "$rootdir/[% c('input_files_by_name/pgo-jarlog') %]" /var/tmp/dist/pgo/jarlog
+  [% END -%]
+[% END -%]
+
 echo "Starting ./mach configure $(date)"
 # We still need to specify --base-browser-version due to bug 34005.
 ./mach configure \
+  [% IF c("var/pgo_generate") -%]--enable-profile-generate[% END %] \
+  [% IF c("var/pgo_use") -%]
+  --enable-profile-use \
+  --with-pgo-profile-path=/var/tmp/dist/pgo/merged.profdata \
+  [% IF c("var/pgo_jarlog_sha256") -%]--with-pgo-jarlog=/var/tmp/dist/pgo/jarlog[% END %] \
+  [% END -%] \
   [% IF !c("var/firefox-browser") %]--with-base-browser-version=[% c("var/torbrowser_version") %][% END %] \
   [% IF !c("var/firefox-browser") %]--with-branding=$branding_dir[% END %] \
