     makensis browser-install.nsi
     python3 $rootdir/pe_checksum_fix.py browser-install.exe
     mv browser-install.exe $OUTDIR/[% c("var/project-name") %]-[% c("var/osname") %]-[% c("var/torbrowser_version") %].exe
+    [% IF c('var/pgo_use') -%]
+    # The stock standalone installer copies this entire tree, not bare firefox.exe.
+    # Its absence of Browser/system-install selects Mullvad portable data paths.
+    python3 - '[% c("var/Project_Name") %]' "$OUTDIR/[% c("var/project-name") %]-[% c("var/osname") %]-portable-[% c("var/torbrowser_version") %].zip" '[% c("var/browser_release_date_timestamp") %]' <<'PY_PGO_PORTABLE'
+import pathlib, stat, sys, time, zipfile
+root = pathlib.Path(sys.argv[1])
+if not (root / "Browser/firefox.exe").is_file():
+    raise SystemExit("portable browser tree is missing firefox.exe")
+if (root / "Browser/system-install").exists():
+    raise SystemExit("portable tree contains the system-install marker")
+launcher = root / "Start Mullvad Browser.cmd"
+launcher.write_bytes(b'@echo off\r\nsetlocal\r\nstart "" /d "%~dp0" "%~dp0Browser\\firefox.exe" %*\r\n')
+stamp = time.gmtime(int(sys.argv[3]))[:6]
+with zipfile.ZipFile(sys.argv[2], "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
+    for path in sorted(root.rglob("*")):
+        if path.is_symlink():
+            raise SystemExit("portable tree contains a symlink")
+        if not path.is_file():
+            continue
+        info = zipfile.ZipInfo(path.as_posix(), stamp)
+        info.compress_type = zipfile.ZIP_DEFLATED
+        info.external_attr = (stat.S_IFREG | 0o644) << 16
+        with path.open("rb") as source, archive.open(info, "w") as output:
+            while block := source.read(1024 * 1024):
+                output.write(block)
+print("Created complete Mullvad standalone portable ZIP.")
+PY_PGO_PORTABLE
+    [% END -%]
   [% ELSE -%]
     makensis browser-portable.nsi
