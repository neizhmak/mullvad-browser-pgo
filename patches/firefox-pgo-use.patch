@@ -118,14 +118,85 @@
   [% END -%]
 [% END -%]
 
+[% IF c("var/pgo_use") -%]
+  [% IF c("var/pgo_generate") -%]
+    echo 'PGO generation and profile use are mutually exclusive' >&2
+    exit 1
+  [% END -%]
+  mkdir -p /var/tmp/dist/pgo
+  cp "$rootdir/[% c('input_files_by_name/pgo-profdata') %]" /var/tmp/dist/pgo/merged.profdata
+  cp "$rootdir/[% c('input_files_by_name/pgo-jarlog') %]" /var/tmp/dist/pgo/jarlog
+[% END -%]
+
 echo "Starting ./mach configure $(date)"
 ./mach configure \
   --with-distribution-id=org.torproject \
   [% IF c("var/pgo_generate") -%]--enable-profile-generate=cross[% END %] \
+[% IF c("var/pgo_use") -%]
+  --enable-profile-use=cross \
+  --with-pgo-profile-path=/var/tmp/dist/pgo/merged.profdata \
+  --with-pgo-jarlog=/var/tmp/dist/pgo/jarlog \
+[% END -%]
   [% IF !c("var/firefox-browser") %]--with-base-browser-version=[% c("var/torbrowser_version") %][% END %] \
   [% IF c("var/updater_enabled") -%]--enable-update-channel=[% c("var/channel") %][% END %] \
   [% IF !c("var/firefox-browser") -%]--with-branding="$branding_dir"[% END %] \
   [% IF !c("var/rlbox") -%]--without-wasm-sandboxed-libraries[% END %]
+
+[% IF c("var/pgo_use") -%]
+# The exact pinned configure.py emits this JSON; do not execute config.status.
+python3 - "[% out_dir %]/pgo-use-proof.json" <<'PY_PGO_PROOF'
+import glob, json, pathlib, sys
+statuses = glob.glob("obj-*/config.status.json")
+if len(statuses) != 1:
+    raise SystemExit("expected exactly one configured Firefox object directory")
+configuration = json.loads(pathlib.Path(statuses[0]).read_text())
+substs = configuration["substs"]
+defines = configuration["defines"]
+profile = "/var/tmp/dist/pgo/merged.profdata"
+jarlog = "/var/tmp/dist/pgo/jarlog"
+for key in ("MOZ_PROFILE_USE", "MOZ_PGO_RUST"):
+    if not substs.get(key):
+        raise SystemExit("configured Firefox did not enable " + key)
+if substs.get("MOZ_PROFILE_GENERATE"):
+    raise SystemExit("configured profile-use Firefox still enables generation")
+if substs.get("PGO_PROFILE_PATH") != profile:
+    raise SystemExit("configured Firefox uses the wrong profile")
+if "-fprofile-use=" + profile not in substs.get("PROFILE_USE_CFLAGS", []):
+    raise SystemExit("C++ profile-use flags are absent from config.status")
+configured_jarlog = substs.get("PGO_JARLOG_PATH")
+if configured_jarlog not in (jarlog, [jarlog], (jarlog,)):
+    raise SystemExit("configured Firefox uses the wrong jarlog")
+# Prove the unchanged official signed Alpha route, not actual MAR integration.
+update_substs = {
+    "MOZ_UPDATER": "1", "BASE_BROWSER_UPDATE": "1", "MOZ_VERIFY_MAR_SIGNATURE": "1",
+    "MOZ_USE_NSS_FOR_MAR": "1", "MOZ_UPDATE_CHANNEL": "alpha",
+    "BB_UPDATER_URL": "https://cdn.mullvad.net/browser/update_responses/update_1",
+    "MAR_CHANNEL_ID": "mullvadbrowser-mullvad-alpha",
+    "ACCEPTED_MAR_CHANNEL_IDS": "mullvadbrowser-mullvad-alpha",
+}
+update_defines = {
+    "MOZ_VERIFY_MAR_SIGNATURE": "1",
+    "BASE_BROWSER_VERSION": "[% c('var/torbrowser_version') %]",
+    "BASE_BROWSER_VERSION_QUOTED": '"[% c('var/torbrowser_version') %]"',
+}
+for section, expected in ((substs, update_substs), (defines, update_defines)):
+    for key, value in expected.items():
+        if section.get(key) != value:
+            raise SystemExit("secure official Alpha updater configuration mismatch: " + key)
+disabled_update_options = ("MOZ_MAINTENANCE_SERVICE", "MOZ_UPDATE_AGENT", "DISABLE_UPDATER_AUTHENTICODE_CHECK")
+for key in disabled_update_options:
+    if substs.get(key) or defines.get(key):
+        raise SystemExit("unexpected updater security/background option: " + key)
+proof = {"schema": 1, "firefox_revision": "[% c('var/git_commit') %]",
+         "pgo_profile_sha256": "[% c('var/pgo_profile_sha256') %]",
+         "pgo_jarlog_sha256": "[% c('var/pgo_jarlog_sha256') %]",
+         "substs": {k: substs.get(k) for k in ("MOZ_PGO", "MOZ_PROFILE_USE", "MOZ_PGO_RUST", "MOZ_PROFILE_GENERATE", "PGO_PROFILE_PATH", "PROFILE_USE_CFLAGS", "PGO_JARLOG_PATH", *update_substs, *disabled_update_options)},
+         "defines": {k: defines.get(k) for k in (*update_defines, *disabled_update_options)},
+         "updater_verification": "unchanged secure official signed Alpha configuration; MAR integration not tested"}
+pathlib.Path(sys.argv[1]).write_text(json.dumps(proof, sort_keys=True, indent=2) + "\n")
+print("Verified configured C++ and Rust cross-language profile use.")
+PY_PGO_PROOF
+[% END -%]
 
 echo "Starting ./mach build $(date)"
 ./mach build --verbose
